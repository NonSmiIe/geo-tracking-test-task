    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(fleet_processor_batch_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (outcome) (rate(fleet_processor_batches_total[1m]))",
     "legendFormat": "{{outcome}} batches/s",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "device_latest",
   "id": 16,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 28
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(pg_stat_user_tables_n_tup_hot_upd{relname=\"device_latest\"}[1m]) / clamp_min(rate(pg_stat_user_tables_n_tup_upd{relname=\"device_latest\"}[1m]), 1)",
     "legendFormat": "HOT share",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "pg_stat_user_tables_n_dead_tup{relname=\"device_latest\"} / clamp_min(pg_stat_user_tables_n_live_tup{relname=\"device_latest\"}, 1)",
     "legendFormat": "dead share",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "description": "HOT updates keep the cell index untouched; dead share climbing means autovacuum is behind."
  },
