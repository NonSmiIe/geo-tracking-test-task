   },
   "targets": [
    {
     "refId": "A",
     "expr": "ALERTS{alertstate=\"firing\"}",
     "instant": true,
     "format": "table",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
